# Porta do servidor backend
PORT=3333

# Chave usada para cifrar credenciais sensíveis (Trello token) salvas no banco.
# Gere uma string aleatória longa, ex: openssl rand -hex 32
ENCRYPTION_KEY=troque-esta-chave-por-uma-aleatoria-de-32-bytes

# Diretório onde o SQLite e a sessão do WhatsApp são persistidos
DATA_DIR=./data
