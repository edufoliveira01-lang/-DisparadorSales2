{
  "name": "disparador-pericias-server",
  "version": "2.71.1",
  "description": "Backend do Disparador de Perícias — API Trello + WhatsApp + SQLite",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "painel": "node dist/painel/index.js",
    "painel:dev": "tsx watch src/painel/index.ts",
    "test": "vitest run",
    "codex:login": "node scripts/codex-login.cjs",
    "codex:install": "node scripts/ensure-codex.cjs"
  },
  "dependencies": {
    "@openai/codex": "0.163.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^11.9.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "disparador-pericias": "file:..",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "handlebars": "^4.7.8",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "string-similarity": "^4.0.4",
    "whatsapp-web.js": "https://codeload.github.com/wwebjs/whatsapp-web.js/tar.gz/064a3d5a5a3dce1281a6a12740b5a7051339d154"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/string-similarity": "^4.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
