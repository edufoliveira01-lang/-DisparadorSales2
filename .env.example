# Copie este arquivo para .env no servidor e mantenha os valores reais fora do Git.
PORT=3333
APP_URL=https://seu-dominio.example

# Chave estável usada para proteger tokens salvos no banco. Gere com: openssl rand -hex 32
ENCRYPTION_KEY=

# OAuth 2.0 do tipo "Aplicativo da Web" no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-dominio.example/api/google-calendar/callback


# Somente para uma NOVA instância isolada. Não ativar na base legada sem migração.
# OFFICE_ID=escritorio-exemplo
# DATA_DIR=/srv/disparazap/escritorio-exemplo/data
# DJEN_CODEX_HOME=/srv/disparazap/escritorio-exemplo/data/codex

# Instalação interna local: local. Produto hospedado/comercial: hosted.
# Não configure local para contornar os requisitos da integração comercial.
# AI_DEPLOYMENT_MODE=local

# ---------------------------------------------------------------------------
# SaaS (opcional) — veja docs/SAAS.md
# ---------------------------------------------------------------------------
# Instância de um escritório assinante: com as três variáveis abaixo o sistema valida a assinatura.
# Sem elas, roda em "modo próprio" (sem limites e sem bloqueios), como a instalação atual.
# LICENSE_SERVER_URL=https://painel.seudominio.com.br
# LICENSE_KEY=dz_...
# LICENSE_PUBLIC_KEY_B64=...   # chave pública do painel, em base64 (o painel gera este bloco)
#
# Painel de controle (npm run painel): planos, escritórios, cobrança e licenças.
# PAINEL_PORT=3340
# PAINEL_DATA_DIR=/srv/disparazap-painel/data
# PAINEL_PUBLIC_URL=https://painel.seudominio.com.br
# PAINEL_BASE_DOMAIN=disparazap.saleseassociados.com.br
# PAINEL_ADMIN_USER=admin
# PAINEL_ADMIN_PASSWORD=          # usada só na primeira execução (mínimo 12 caracteres); depois remova
# ASAAS_API_KEY=
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3   # produção: https://api.asaas.com/v3
# ASAAS_WEBHOOK_TOKEN=            # 32 a 255 caracteres; o mesmo valor cadastrado no webhook do Asaas
