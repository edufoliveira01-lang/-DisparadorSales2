# Copie este arquivo para .env no servidor e mantenha os valores reais fora do Git.
PORT=3333
APP_URL=https://seu-dominio.example

# Chave estável usada para proteger tokens salvos no banco. Gere com: openssl rand -hex 32
ENCRYPTION_KEY=

# OAuth 2.0 do tipo "Aplicativo da Web" no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-dominio.example/api/google-calendar/callback
